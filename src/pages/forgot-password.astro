---
import Layout from '../layouts/Layout.astro';
import { ForgotPasswordForm } from '../components/auth/ForgotPasswordForm';
---

<Layout title="Reset Access — JobAI Candidate Platform" showFooter={false}>
  <div class="min-h-[calc(100vh-4.5rem)] flex items-center justify-center p-4 sm:p-6 lg:p-8 relative overflow-hidden">
    {/* Grid Background */}
    <div class="absolute inset-0 bg-grid-pattern opacity-40 pointer-events-none" />
    <div class="absolute top-1/4 right-10 w-72 h-72 bg-indigo-200/20 rounded-full blur-3xl pointer-events-none" />

    <div class="w-full relative z-10 py-8">
      <ForgotPasswordForm client:load />
    </div>
  </div>
</Layout>
