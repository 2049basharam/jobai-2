---
import Layout from '../layouts/Layout.astro';
import { RegisterWizard } from '../components/auth/RegisterWizard';
---

<Layout title="Register Profile — JobAI Candidate Experience" showFooter={false}>
  <div class="min-h-[calc(100vh-4.5rem)] flex items-center justify-center p-4 sm:p-6 lg:p-8 relative overflow-hidden">
    {/* Background Grid Pattern */}
    <div class="absolute inset-0 bg-grid-pattern opacity-40 pointer-events-none" />
    <div class="absolute top-10 right-10 w-80 h-80 bg-indigo-200/20 rounded-full blur-3xl pointer-events-none" />
    <div class="absolute bottom-10 left-10 w-80 h-80 bg-cyan-200/20 rounded-full blur-3xl pointer-events-none" />

    <div class="w-full relative z-10 py-8">
      <RegisterWizard client:load />
    </div>
  </div>
</Layout>
