---
import Layout from '../layouts/Layout.astro';
import { LoginForm } from '../components/auth/LoginForm';
---

<Layout title="Sign In — JobAI Candidate Platform" showFooter={false}>
  <div class="min-h-[calc(100vh-4.5rem)] flex flex-col justify-center p-4 sm:p-6 lg:p-8 relative overflow-hidden">
    {/* Subtle Background Intelligence Grid */}
    <div class="absolute inset-0 bg-grid-pattern opacity-40 pointer-events-none" />
    <div class="absolute top-1/4 left-10 w-72 h-72 bg-indigo-200/20 rounded-full blur-3xl pointer-events-none" />
    <div class="absolute bottom-10 right-10 w-80 h-80 bg-cyan-200/20 rounded-full blur-3xl pointer-events-none" />

    <div class="w-full relative z-10 my-auto">
      <LoginForm client:load />
    </div>
  </div>
</Layout>
