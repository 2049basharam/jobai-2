---
import { Sparkles, ArrowRight, ArrowLeft } from 'lucide-react';

const pathname = Astro.url.pathname;
const isLoginPage = pathname === '/login' || pathname === '/login/';
const isRegisterPage = pathname === '/register' || pathname === '/register/';
const isForgotPasswordPage = pathname === '/forgot-password' || pathname === '/forgot-password/';
const isAuthPage = isLoginPage || isRegisterPage || isForgotPasswordPage;
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200/80 transition-all shadow-jobai-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between py-3.5">
    <!-- Logo & Brand (Click to return to home) -->
    <a href="/" class="flex items-center gap-2.5 group" title="Return to JobAI Home">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-jobai-primary via-indigo-600 to-jobai-cyan flex items-center justify-center text-white shadow-jobai-sm group-hover:scale-105 transition-transform">
        <Sparkles className="w-5 h-5 text-cyan-200" />
      </div>
      <div class="flex items-center gap-1.5">
        <span class="font-heading font-extrabold text-xl tracking-tight text-slate-900">
          Job<span class="text-gradient-primary">AI</span>
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    {!isAuthPage ? (
      <nav class="hidden md:flex items-center gap-8">
        <a href="/#intelligence" class="text-xs font-semibold text-slate-600 hover:text-jobai-primary transition-colors uppercase tracking-wider">
          Career Intelligence
        </a>
        <a href="/#discovery" class="text-xs font-semibold text-slate-600 hover:text-jobai-primary transition-colors uppercase tracking-wider">
          Opportunities
        </a>
        <a href="/#skill-gap" class="text-xs font-semibold text-slate-600 hover:text-jobai-primary transition-colors uppercase tracking-wider">
          Skill Gap Analysis
        </a>
        <a href="/#copilot" class="text-xs font-semibold text-slate-600 hover:text-jobai-primary transition-colors uppercase tracking-wider">
          AI Copilot
        </a>
      </nav>
    ) : (
      <nav class="hidden sm:flex items-center">
        <a
          href="/"
          class="text-xs font-mono font-bold text-slate-600 hover:text-slate-950 transition-colors uppercase tracking-wider inline-flex items-center gap-1.5 py-1.5 px-3 rounded-lg hover:bg-slate-100 border border-slate-200/80"
        >
          <ArrowLeft className="w-3.5 h-3.5 stroke-[2.5]" />
          <span>Back to Home</span>
        </a>
      </nav>
    )}

    <!-- Header Actions -->
    <div class="flex items-center gap-3">
      {isAuthPage && (
        <a
          href="/"
          class="sm:hidden text-xs font-mono font-bold text-slate-600 hover:text-slate-900 px-2.5 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-50 transition-all uppercase tracking-wider inline-flex items-center gap-1"
        >
          <ArrowLeft className="w-3.5 h-3.5 stroke-[2.5]" />
          <span>Home</span>
        </a>
      )}
      {(!isAuthPage || isRegisterPage || isForgotPasswordPage) && (
        <a
          href="/login"
          class="text-xs font-semibold text-slate-700 hover:text-slate-900 px-3.5 py-2 rounded-xl transition-colors hover:bg-slate-100"
        >
          Sign In
        </a>
      )}
      {(!isAuthPage || isLoginPage) && (
        <a
          href="/register"
          class="inline-flex items-center gap-1.5 text-xs font-semibold px-4 py-2.5 rounded-xl bg-jobai-primary hover:bg-jobai-primary-hover text-white shadow-jobai-sm transition-all hover:scale-[1.02] active:scale-[0.98]"
        >
          <span>Get Started</span>
          <ArrowRight className="w-3.5 h-3.5" />
        </a>
      )}
    </div>
  </div>
</header>
